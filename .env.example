# Copia a .env SOLO para el demo local. Nunca subas este archivo con la clave.
# Proveedor del modelo AÚN NO APROBADO por Marcos: no crees cuentas ni claves hasta el OK.
# Sin clave, el widget muestra «el asistente aún no está activo» y deriva a WhatsApp.

# Cualquier API compatible con OpenAI (/chat/completions):
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Ejemplo si se aprueba Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Orígenes extra permitidos por CORS (separados por coma), opcional:
# ALLOWED_ORIGINS=https://mi-preview.netlify.app
